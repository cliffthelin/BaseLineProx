# Ordering directives only, copied from Proxmox VE 9.2's package for this unit; [Service] is a stub.
[Unit]
Description=PVE Status Daemon
ConditionPathExists=/usr/bin/pvestatd
Wants=pve-cluster.service
After=pve-cluster.service pvenetcommit.service

[Service]
ExecStart=/bin/true

[Install]
WantedBy=multi-user.target
