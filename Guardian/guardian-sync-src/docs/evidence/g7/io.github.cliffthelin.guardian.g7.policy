<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Guardian Plane G7 production helper</vendor>
  <action id="io.github.cliffthelin.guardian.g7.bounded-write">
    <description>Guardian G7 bounded Class A privileged write</description>
    <message>Guardian G7 bounded Class A privileged write</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>no</allow_active></defaults>
  </action>
</policyconfig>
