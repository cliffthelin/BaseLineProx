#!/usr/bin/env python3
"""Move credentials YOU already have into the Baseline vault. Run by the operator, on a file the operator names.

    tools/vault-import /path/to/credentials.env            # KEY=VALUE lines (OPENAI_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY,
                                                           #  CLAUDE_CODE_OAUTH_TOKEN); other names are skipped, never copied
    tools/vault-import FILE --vault admin|personal|both    # USER_ADMIN's vault, USER_PERSONAL's, or both (default: admin)

The file must be mode 0600. A vault that has a passphrase is asked for it (never echoed) and is filled sealed. Values are never printed.
An agent does not run this on the operator's behalf: it never reads or handles the operator's own credentials.
"""
import getpass
import os
import re
import stat
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "baseline" / "lib"))
import vault as v  # noqa: E402

ALLOWED = ("OPENAI_API_KEY", "GEMINI_API_KEY", "GOOGLE_API_KEY", "OPENROUTER_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN")
_LINE = re.compile(r"^\s*(?:export\s+)?([A-Z][A-Z0-9_]+)=(.*?)\s*$")


def import_file(source, vault, passphrase):
    source = Path(source)
    if not source.is_file() or source.is_symlink():
        raise SystemExit(f"{source} is not a plain file")
    if stat.S_IMODE(source.stat().st_mode) & 0o077:
        raise SystemExit(f"{source} is readable by others; run: chmod 600 {source}")
    imported, skipped = [], []
    for line in source.read_text().splitlines():
        m = _LINE.match(line)
        if not m:
            continue
        name, value = m.group(1), m.group(2).strip().strip("'\"")
        if name not in ALLOWED:
            skipped.append(name)
            continue
        vault.put(name, value, passphrase=passphrase)
        imported.append(name)
    return {"imported": imported, "skipped": skipped}


def main(argv):
    if not argv or argv[0].startswith("-"):
        print(__doc__)
        return 2
    which = argv[argv.index("--vault") + 1] if "--vault" in argv else "admin"
    roots = {"admin": [v.ADMIN_VAULT], "personal": [v.PERSONAL_VAULT], "both": [v.ADMIN_VAULT, v.PERSONAL_VAULT]}.get(which)
    if roots is None:
        print("--vault is admin, personal or both")
        return 2
    for root in roots:
        vault = v.Vault(root)
        passphrase = None
        if vault.has_passphrase():
            passphrase = getpass.getpass(f"passphrase for {root}: ")
            if not vault.check_passphrase(passphrase):
                print(f"wrong passphrase for {root}")
                return 1
        report = import_file(argv[0], vault, passphrase)
        print(f"{root}: imported {', '.join(report['imported']) or 'nothing'}; skipped {', '.join(report['skipped']) or 'nothing'}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
