#!/usr/bin/env python3
"""Thin installed entry point for one recurring encrypted-backup cycle
(work-queue item 27, decision record 79). Invoked by
`baseline-backup-recurring.timer` - one attempt per real persona
(`drive_installer.DEFAULT_PERSONAS`), each skipped if that persona was
already backed up within the configured interval. See
`lib/backup_recurring.py`'s module docstring for what this does and
does not yet guarantee (no genuinely separate physical device target
exists in this codebase's own real-hardware testing yet).

The encryption password is never hardcoded or passed as a CLI
argument - it must already exist as a private, ephemeral file at the
path named by BASELINE_BACKUP_PASSWORD_FILE, matching this project's
established password-handling discipline (config_crypto.py's own
docstring). A real deployment without that file configured yet simply
fails this unit's own run - it never silently skips encryption.
"""
import os
import sys

sys.path.insert(0, "/opt/baseline/lib")
import backup_recurring  # noqa: E402
import drive_installer  # noqa: E402

if __name__ == "__main__":
    password_file = os.environ.get("BASELINE_BACKUP_PASSWORD_FILE", "")
    if not password_file:
        print("[FAILED] BASELINE_BACKUP_PASSWORD_FILE is not set - refusing to run without a real encryption password")
        sys.exit(1)
    sys.exit(backup_recurring.main(password_file=password_file, personas=drive_installer.DEFAULT_PERSONAS))
