#!/usr/bin/env python3
"""Kasm Workspaces on this Proxmox host (DR260).

  baseline-kasm setup        build the Kasm VM from the carried base and install Kasm in it, if that is not already done (safe to repeat)
  baseline-kasm status       what is there now; changes nothing
  baseline-kasm mode persist|reset
                             persist (default): everything done in the VM is kept. reset: everything done during a run is discarded and the VM starts from where
                             it was; restarts the VM
  baseline-kasm telemetry collect|report
                             collect: ask the running VM how it is doing and keep the answer; report: what the history says to change, and why (JSON)
  baseline-kasm dehydrate --yes
                             remove the VM and keep everything it held; `setup` builds it again exactly as it was
  baseline-kasm reset-root --yes
                             DISCARD the persisted OS layer and boot a new one over the same base; Kasm's data and the profiles are kept

Prints one JSON object. Exit 0 when done (or, for setup, when there is nothing to build from yet), 1 when it stopped, with the reason on stderr.
The vault passphrase, when the vault has one, is read from the first line of stdin with --passphrase-stdin.
"""
import json
import sys

sys.path.insert(0, "/opt/baseline/lib")
import kasm_setup  # noqa: E402


def main(argv):
    command = argv[1] if len(argv) > 1 else ""
    if command not in ("setup", "status", "mode", "dehydrate", "reset-root", "telemetry"):
        print(__doc__, file=sys.stderr)
        return 2
    if command == "mode" and (len(argv) < 3 or argv[2] not in ("persist", "reset")):
        print("baseline-kasm mode: say persist or reset", file=sys.stderr)
        return 2
    if command == "telemetry" and (len(argv) < 3 or argv[2] not in ("collect", "report")):
        print("baseline-kasm telemetry: say collect or report", file=sys.stderr)
        return 2
    if command in ("dehydrate", "reset-root") and "--yes" not in argv:
        print(f"baseline-kasm {command}: this needs --yes", file=sys.stderr)
        return 2
    passphrase = sys.stdin.readline().rstrip("\n") if "--passphrase-stdin" in argv else None
    import repair
    import volume_growth
    machine = kasm_setup.KasmSetup(ensure_room=lambda label, needed: volume_growth.ensure_room(repair.RealRunner(), label, needed))
    try:
        if command == "setup":
            if not machine.layout.base.is_file() and machine.existing_vmid() is None:
                print(json.dumps({"skipped": "this installer carries no Kasm base"}))
                return 0
            result = machine.setup(passphrase=passphrase)
        elif command == "status":
            result = machine.status()
        elif command == "telemetry":
            result = machine.collect_telemetry() if argv[2] == "collect" else machine.telemetry_report()
        elif command == "mode":
            result = machine.set_mode(argv[2])
        elif command == "dehydrate":
            result = machine.dehydrate()
        else:
            result = machine.reset_root(confirm=True)
    except kasm_setup.KasmSetupError as exc:
        print(f"baseline-kasm: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
