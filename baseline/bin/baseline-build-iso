#!/usr/bin/env python3
"""Real entry point for building a "current" Baseline installer ISO -
remasters the already-verified Proxmox auto-install ISO
(drive_setup_answer.prepare_iso_defensively's own output) with this
repo's own boot/provision.sh + baseline/ tree, so a fresh install
needs no separate git-clone/copy step. See lib/iso_builder.py's module
docstring for the real xorriso mechanics and why this is safe.

    baseline-build-iso --source-iso /path/to/proxmox-auto-install.iso \
        --repo-root /path/to/baseline_repo \
        [--output /mnt/INSTALLER_CACHE/isos/baseline-current.iso] \
        [--workspace /var/tmp/baseline-iso-build]

Defaults the output path onto the real INSTALLER_CACHE partition
(drive_installer.py's own BASELINE_VOLUMES mountpoint) - the installer
media itself belongs there, alongside cached driver packages, not on
USER_PERSISTENCE (credentials/config/logs) or the disposable substrate.
"""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, "/opt/baseline/lib")
import iso_builder as ib  # noqa: E402

DEFAULT_OUTPUT = "/mnt/INSTALLER_CACHE/isos/baseline-current.iso"
DEFAULT_WORKSPACE = "/var/tmp/baseline-iso-build"


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="baseline-build-iso")
    parser.add_argument("--source-iso", required=True,
                         help="the already-verified Proxmox auto-install ISO to remaster")
    parser.add_argument("--repo-root", required=True,
                         help="path to this repo - boot/ and baseline/ are staged from here")
    parser.add_argument("--output", default=DEFAULT_OUTPUT)
    parser.add_argument("--workspace", default=DEFAULT_WORKSPACE)
    args = parser.parse_args(argv)

    runner = ib.RealIsoBuilderRunner()
    result = ib.build_current_iso(
        runner, source_iso=Path(args.source_iso), repo_root=Path(args.repo_root),
        output_iso=Path(args.output), workspace=Path(args.workspace),
    )
    print(json.dumps({
        "ok": result.ok,
        "output_path": str(result.output_path) if result.output_path else None,
        "postconditions": [{"name": c.name, "ok": c.ok, "detail": c.detail} for c in result.postconditions],
    }, indent=2))
    return 0 if result.ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
