#!/usr/bin/env python3
"""Make the update bundle for an existing build from the committed repository: baseline-prepare-update-bundle PC601 (target name from the lane's drives file). Prints the bundle folder."""
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import lane_files  # noqa: E402

lane_files.apply_defaults(os.environ)


def main(argv):
    if len(argv) != 2:
        print(__doc__, file=sys.stderr)
        return 2
    import update_bundle
    from repair import RealRunner
    drives_file = Path(os.environ.get("BASELINE_DRIVES_FILE") or lane_files.BUILD_DRIVES_FILE)
    try:
        known = set(json.loads(drives_file.read_text()).get("drives", {}))
        repo = Path(__file__).resolve().parents[2]
        folder = update_bundle.prepare_update_bundle(RealRunner(), repo, drives_file.parent / "update-bundles", argv[1], known_targets=known)
    except Exception as exc:                                         # noqa: BLE001 - reported with a nonzero exit
        print(f"not prepared: {exc}", file=sys.stderr)
        return 1
    print(folder)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
