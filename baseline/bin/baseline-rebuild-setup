#!/bin/sh
# One-time (re-run to refresh): installs the remote-rebuild service. Needs root: sudo baseline/bin/baseline-rebuild-setup
# Usage: sudo baseline/bin/baseline-rebuild-setup [--group GROUP] [--hours N] [DRIVE ...]   (default: every drive in the operator's drives file, group = the caller's primary group, 24 hours)
# Makes a root-owned copy of the SERVICE (it only changes when this is re-run); the source a rebuild installs is pinned per request, at the commit current when the request is made, writes its settings, and enables the systemd unit.
set -eu
[ "$(id -u)" = 0 ] || { echo "run with sudo" >&2; exit 1; }
REPO=$(cd "$(dirname "$0")/../.." && pwd)
OPERATOR=${SUDO_USER:-${PKEXEC_UID:+$(id -nu "$PKEXEC_UID")}}
GROUP=""; HOURS=24
while [ $# -gt 0 ]; do case "$1" in --group) GROUP=$2; shift 2;; --hours) HOURS=$2; shift 2;; *) break;; esac; done
if [ -z "$GROUP" ]; then [ -n "$OPERATOR" ] || { echo "name the group that may send requests: --group NAME" >&2; exit 1; }; GROUP=$(id -gn "$OPERATOR"); fi
GID=$(getent group "$GROUP" | cut -d: -f3); [ -n "$GID" ] || { echo "no group $GROUP" >&2; exit 1; }
DRIVES=${BASELINE_DRIVES_FILE:-/run/media/cane/CACHE/baseline-build/drives.json}
OWN=$(dirname "$DRIVES")/own-drives
SRC=/opt/baseline-rebuilder/src
rm -rf "$SRC"; mkdir -p /opt/baseline-rebuilder
git clone -q --no-hardlinks "$REPO" "$SRC"
git -C "$SRC" checkout -q "$(git -C "$REPO" rev-parse HEAD)"
chown -R root:root /opt/baseline-rebuilder; chmod -R go-w /opt/baseline-rebuilder
mkdir -p /etc/baseline-rebuild
python3 - "$SRC" "$DRIVES" "$HOURS" "$@" <<'P'
import json, subprocess, sys
sys.path.insert(0, sys.argv[1] + "/baseline/lib")
import rebuild_policy as rp
src, drives_file, hours, names = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4:]
known = json.load(open(drives_file))["drives"]
chosen = {n: known[n] for n in (names or known)}
sizes = {}
for line in subprocess.run(["lsblk", "-dbn", "-o", "SERIAL,SIZE"], capture_output=True, text=True).stdout.splitlines():
    parts = line.split()
    if len(parts) == 2:
        sizes[parts[0]] = int(parts[1])
missing = [n for n, serial in chosen.items() if serial not in sizes]
if missing:
    sys.exit("these drives are not attached, so their identity cannot be pinned: " + ", ".join(missing))
policy = rp.build({n: rp.drive_identity(s, sizes[s]) for n, s in chosen.items()}, ttl_hours=hours)
rp.write("/etc/baseline-rebuild/policy.json", "/etc/baseline-rebuild/policy.sha256", policy)
print("policy covers:", ", ".join(sorted(chosen)), "- command pinned by", rp.policy_digest(policy))
P
chmod 644 /etc/baseline-rebuild/policy.json /etc/baseline-rebuild/policy.sha256
cat > /etc/baseline-rebuild.json <<J
{"drives_file": "$DRIVES", "own_drives_file": "$OWN", "gid": $GID, "repo": "$REPO", "policy_file": "/etc/baseline-rebuild/policy.json", "policy_digest_file": "/etc/baseline-rebuild/policy.sha256", "parent_vault": "$(dirname "$DRIVES")/vault"}
J
chmod 644 /etc/baseline-rebuild.json
cat > /etc/systemd/system/baseline-rebuild.service <<U
[Unit]
Description=Baseline remote rebuild authorization
After=local-fs.target
[Service]
ExecStart=/usr/bin/python3 $SRC/baseline/bin/baseline-rebuild-service
Environment=BASELINE_REBUILD_SRC=$SRC
Restart=always
[Install]
WantedBy=multi-user.target
U
systemctl daemon-reload
systemctl enable --now baseline-rebuild.service
echo "ready: baseline/bin/baseline-rebuild request <drive>"
