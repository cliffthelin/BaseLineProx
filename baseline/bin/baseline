#!/usr/bin/env python3
"""Baseline Core - Step 3/7: a real Textual TUI on tty1.

Replaces the plain input()-loop REPL with a mouse-capable, persistent
interface - still on the raw Linux console (no kmscon/DRM yet, no
Wayland/X), so fonts stay bitmap and mouse fidelity is whatever the
console itself supports. kmscon (antialiased fonts, full mouse) is a
deliberate follow-up, not done here - see the PRD's Step 7 discussion.
"""
import json
import sys
from pathlib import Path

from textual import work
from textual.app import App, ComposeResult
from textual.containers import Horizontal
from textual.widgets import Button, DataTable, Footer, Header, Input, Log, TabbedContent, TabPane

sys.path.insert(0, "/opt/baseline/lib")
import hardware  # noqa: E402
import network  # noqa: E402
import harness  # noqa: E402
import tether  # noqa: E402

SNAPSHOT_PATH = Path("/var/lib/baseline/hardware_snapshot.json")


class BaselineApp(App):
    TITLE = "BASELINE"
    SUB_TITLE = "System ready"
    CSS = """
    Screen { background: $surface; }
    DataTable { height: 1fr; }
    #chat_log { height: 1fr; border: solid $accent; }
    #chat_input { dock: bottom; }
    .toolbar { height: 3; }
    """
    BINDINGS = [("q", "quit", "Quit")]

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with TabbedContent(initial="hardware_tab"):
            with TabPane("Hardware", id="hardware_tab"):
                with Horizontal(classes="toolbar"):
                    yield Button("Refresh", id="hw_refresh", variant="primary")
                yield DataTable(id="hw_table")
            with TabPane("Network", id="network_tab"):
                with Horizontal(classes="toolbar"):
                    yield Button("Refresh", id="net_refresh", variant="primary")
                    yield Button("Tether", id="net_tether", variant="warning")
                yield DataTable(id="net_table")
            with TabPane("Chat", id="chat_tab"):
                yield Log(id="chat_log")
                yield Input(placeholder="Ask Baseline...", id="chat_input")
        yield Footer()

    def on_mount(self) -> None:
        self.query_one("#hw_table", DataTable).add_columns("Field", "Value")
        self.query_one("#net_table", DataTable).add_columns("Stage", "Status", "Detail")
        self.refresh_hardware()
        self.refresh_network()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        if event.button.id == "hw_refresh":
            self.refresh_hardware()
        elif event.button.id == "net_refresh":
            self.refresh_network()
        elif event.button.id == "net_tether":
            self.run_tether()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        if event.input.id != "chat_input" or not event.value.strip():
            return
        question = event.value.strip()
        event.input.value = ""
        log = self.query_one("#chat_log", Log)
        log.write_line(f"> {question}")
        self.ask_harness(question)

    def refresh_hardware(self) -> None:
        table = self.query_one("#hw_table", DataTable)
        table.clear()
        raw, err = hardware.collect()
        if err:
            table.add_row("error", err)
            return
        current = hardware.normalize(raw)
        table.add_row("System", f"{current['machine']['system']} ({current['machine']['type']})")
        table.add_row("CPU", f"{current['cpu']['model']} x{current['cpu']['cores']}")
        table.add_row("Memory", f"{current['memory']['total']} total, {current['memory']['used']} used")
        table.add_row("Kernel", f"{current['system']['kernel']} ({current['system']['distro']})")
        SNAPSHOT_PATH.parent.mkdir(parents=True, exist_ok=True)
        SNAPSHOT_PATH.write_text(json.dumps(current, indent=2))

    def refresh_network(self) -> None:
        table = self.query_one("#net_table", DataTable)
        table.clear()
        for f in network.check_lifeline():
            status = "[green]OK[/green]" if f["ok"] else "[red]FAIL[/red]"
            table.add_row(f["fact"], status, f["detail"])

    @work(thread=True)
    def run_tether(self) -> None:
        tether.auto_tether()
        self.call_from_thread(self.refresh_network)

    @work(thread=True)
    def ask_harness(self, question: str) -> None:
        answer = harness.ask(question)
        self.call_from_thread(self._write_chat, answer)

    def _write_chat(self, answer: str) -> None:
        log = self.query_one("#chat_log", Log)
        log.write_line(answer)
        log.write_line("")


def main() -> int:
    BaselineApp().run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
