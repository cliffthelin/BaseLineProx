#!/usr/bin/env python3
"""Boot-time entry point: before networking starts, point a bridge whose NIC does not exist on this machine at the one wired NIC that has a link."""
import sys

sys.path.insert(0, "/opt/baseline/lib")
import bridge_port  # noqa: E402

if __name__ == "__main__":
    # `--retry` is the periodic run on a machine that is already up: a cable plugged in after boot gets the bridge its port, and the
    # change is applied at once (the boot-time run happens before networking and only edits the file).
    retry = "--retry" in sys.argv[1:]
    print(bridge_port.run(wait_seconds=3.0, reload=True) if retry else bridge_port.run())
