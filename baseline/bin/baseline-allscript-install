#!/usr/bin/env python3
"""Take one SK hynix drive from wipe to a working Baseline desktop by script only - no web UI in the install path.

The installer is self-contained: the ISO carries Proxmox, the Baseline source and an offline package cache, and the
installed system finishes its own installation on first boot with no internet and nothing attached but the ISO.
This script only builds that installer and runs it against the chosen target drive under KVM:

  preflight    read-only: target identity by serial, the other drive protected, cached Proxmox ISO, assistant, space
  recovery     add-only, verified whole-drive image of the target in /mnt/10TB/backup   (drive_recovery)  [root]
  cache        build the offline package cache once (baseline-build-offline-cache), verify its manifest
  install      self_installer with the cache and first-boot hook: Proxmox installs onto the target, then its
               first boot lays out storage, carries the ISO + environment onto INSTALLER_CACHE and provisions
               offline; ends at the first-boot authorization screen                                    [root]
  firstboot    type CONFIRM into that same session; ends when the kiosk browser shows Proxmox
  kiosk        capture the kiosk screen and shut the target down cleanly

Nothing reads console text automatically (no OCR, by design): the person or vision-capable agent watching
<work>/session-latest.ppm records each checkpoint with the `touch` the script prints. The work folder is
/run/media/cane/CACHE/baseline-build/allscript-<target> - on ext4, never inside the repo (which may be on an NTFS
drive where screendumps and private-file modes fail), and one per target so two drives' runs never share progress.

There is NO default target. Two SK hynix drives exist and two agents share this machine, each with its own drive
(2026-10-10: Claude uses PC601, Codex uses PC401). Name the target with --target, or let an exact --confirm-wipe
serial imply it; the OTHER drive is then protected for that run. Every destructive step re-validates the target
through physical_device_safety.validate_target_device. The data-protection guard in self_installer is honoured,
never bypassed: the target must be empty or carry an installer-made identity.

    sudo baseline/bin/baseline-allscript-install --target PC601 --from recovery --confirm-wipe FD01N6557110C271B
    baseline/bin/baseline-allscript-install --target PC601 --stage preflight    # read-only, no root needed
    baseline/bin/baseline-allscript-install --stage rehearse                    # sparse image, no real drive
"""
import argparse
import json
import os
import secrets
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

def locate_assistant(candidates):
    """The verified proxmox-auto-install-assistant: the copy on CACHE first, the older host location second."""
    return next((c for c in candidates if Path(c).is_file()), Path(candidates[0]))


REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / "baseline/lib"))

DRIVES = {"PC401": "MD89N41071210AP4E", "PC601": "FD01N6557110C271B"}   # both 512110190592-byte SK hynix NVMe
SIZE = 512110190592
TARGET_NAME = None                    # chosen per run by select_target(); there is deliberately no default
SERIAL = None                         # the chosen target's serial
PROTECTED = None                      # the other drive's serial: never a target in this run
DRIVE_STAGES = {"preflight", "recovery", "install", "firstboot", "kiosk", "identity"}  # touch a real drive (rehearse does not)
WORK = None                           # set by select_work(): BUILD/allscript-<target>
SOURCE_ISO = Path("/run/media/cane/CACHE/baseline_iso/proxmox-ve_9.2-1.iso")
_ASSISTANT_REL = "extracted/usr/bin/proxmox-auto-install-assistant"
ASSISTANT_CANDIDATES = [Path("/run/media/cane/CACHE/baseline-build/assistant/acquire") / _ASSISTANT_REL,
                        Path("/var/tmp/baseline-self-installer/acquire") / _ASSISTANT_REL]
BACKUP_ROOT = Path("/mnt/10TB/backup")
OS_ISOS = Path("/mnt/INSTALLER_CACHE/isos")     # vanilla installer ISOs already on this machine
ASSISTANT = locate_assistant(ASSISTANT_CANDIDATES)
PROXY = REPO / "baseline/lib/installer_package_proxy.py"  # allowlisted package proxy, listens on 127.0.0.1:32165
PROXY_PORT = 32165
OPERATOR = "cane"                               # owner of the work directory, so the run can be followed

BUILD = Path("/run/media/cane/CACHE/baseline-build")   # build workspace only; nothing installed depends on it
CACHE_DIR = BUILD / "offline-cache"
APPS_DIR = BUILD / "apps"                                 # the five applications, prepared on this machine
OS_OFFER = None                                           # folder of OS images offered to the installer VM
INSTALL_VM = None                                         # the install stage's KVM session, continued by later stages

STAGES = ("preflight", "recovery", "cache", "install", "firstboot", "kiosk")
OPTIONAL_STAGES = ("rehearse", "identity")        # run explicitly: --stage rehearse, then --stage firstboot/kiosk in one go
ROOT_STAGES = {"recovery"}             # imaging needs a complete process-use inspection (drive_recovery.quiesce_source); install does not,
                                       # once the drive carries no LVM volumes (see deactivate_target_vgs)


# --- pure decisions (unit-tested) --------------------------------------------------------------

def select_stages(stage, start):
    if stage == "rehearse":
        return ["rehearse", "firstboot", "kiosk"]           # one KVM session from install to kiosk
    if stage is not None:
        if stage not in STAGES + ("identity",):
            raise ValueError(f"unknown stage {stage!r}; stages are: {', '.join(STAGES)}, identity")
        return [stage]
    if start is not None:
        if start not in STAGES:
            raise ValueError(f"unknown stage {start!r}; stages are: {', '.join(STAGES)}")
        return list(STAGES[STAGES.index(start):])
    return list(STAGES)


def target_for(target_arg, confirm_wipe, stages):
    """(name, serial, protected_serial) for this run, or (None, None, None) when no stage touches a real drive.

    Never defaults: two drives exist and each belongs to a different agent, so guessing would be a destructive
    choice made for someone. An exact --confirm-wipe serial may imply the target; if both are given they must
    agree."""
    implied = next((name for name, serial in DRIVES.items() if serial == confirm_wipe), None)
    if target_arg is not None and target_arg not in DRIVES:
        raise ValueError(f"unknown target {target_arg!r}; targets are: {', '.join(DRIVES)}")
    if target_arg is not None and implied is not None and implied != target_arg:
        raise ValueError(f"--target {target_arg} but --confirm-wipe names {implied}'s serial; refusing")
    name = target_arg or implied
    touches_drive = bool(set(stages) & DRIVE_STAGES) and "rehearse" not in stages
    if name is None:
        if touches_drive:
            raise ValueError(f"stages {', '.join(sorted(set(stages) & DRIVE_STAGES))} touch a real drive: "
                             f"name it with --target ({' or '.join(DRIVES)}); there is no default")
        return None, None, None
    protected = next(serial for other, serial in DRIVES.items() if other != name)
    return name, DRIVES[name], protected


def select_target(name, serial, protected):
    global TARGET_NAME, SERIAL, PROTECTED
    TARGET_NAME, SERIAL, PROTECTED = name, serial, protected


def work_dir(name, stages):
    """Per target, on ext4, never inside the repo."""
    if name is not None:
        return BUILD / f"allscript-{name}"
    return BUILD / ("allscript-rehearsal" if "rehearse" in stages else "allscript-shared")


def active_lvm_volumes(listing):
    """Names of the LVM volumes this host currently has active on the drive, from `lsblk -J` output (readable without root)."""
    found = []

    def walk(nodes):
        for node in nodes or []:
            if node.get("type") == "lvm":
                found.append(node["name"])
            walk(node.get("children"))
    walk(listing.get("blockdevices"))
    return found


def refresh_udev_view(device):
    """Open `device` for writing and close it, writing nothing: udev's watch then re-probes it. Returns whether it could."""
    try:
        os.close(os.open(str(device), os.O_WRONLY))
    except OSError:
        return False
    time.sleep(2)
    return True


def fqdn_for(target_name):
    """Hostname for the install: named after the drive it goes on, so two efforts never share a name on one network."""
    if target_name not in DRIVES:
        raise ValueError(f"unknown target {target_name!r}")
    return f"baseline-{target_name.lower()}.local"


def identity_directory():
    """The folder that holds this lane's pinned installer UUID (baseline/INSTALLER_UUID)."""
    return REPO / "baseline"


def vm_using(device, *, proc_root="/proc"):
    """PID of a QEMU process that has `device` on its command line (read-only scan), or None."""
    for entry in Path(proc_root).iterdir():
        if not entry.name.isdigit():
            continue
        try:
            argv = (entry / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        if not argv or b"qemu" not in Path(argv[0].decode(errors="replace")).name.encode():
            continue
        wanted = str(device).encode()
        # QEMU names the device inside a -drive option: file=/dev/sdb,format=raw,...  (or as a bare argument)
        if any(arg == wanted or arg == b"file=" + wanted or arg.startswith(b"file=" + wanted + b",") for arg in argv):
            return int(entry.name)
    return None


def finalize_target_identity():
    """Once the installer's VM has exited: stamp the drive with its stable identity (installer UUID + serial) and register it.
    Runs after a failed install too, so the data-protection guard recognises whatever partial install is on the drive."""
    import installer_identity as ii
    target = identify(runner())
    pid = vm_using(target["path"])
    if pid is not None:
        say(f"not stamping {TARGET_NAME}: a VM (pid {pid}) still has {target['path']} open")
        return None
    installer = ii.installer_id(identity_directory())
    wanted = ii.stamp_child_identity(target["path"], SERIAL, installer)
    refresh_udev_view(target["path"])
    say(f"{TARGET_NAME} identity {wanted}  (installer {installer}, serial {SERIAL}); registered")
    record("identity", uuid=wanted, installer=installer)
    return wanted


def root_required(stages):
    return sorted(set(stages) & ROOT_STAGES)


def cache_status(cache_dir):
    """missing, built before the applications were carried (without_apps), or complete."""
    cache_dir = Path(cache_dir)
    if not (cache_dir / "MANIFEST.json").is_file():
        return "missing"
    return "complete" if (cache_dir / "apps").is_dir() else "without_apps"


def cache_seeds(installer_cache, earlier):
    """What a cache build starts from before downloading anything: earlier caches, the volume's own package and
    firmware folders (installer_cache.py's layout), and the cache this machine's own drive carried and learned."""
    candidates = [*map(Path, earlier), Path(installer_cache) / "packages", Path(installer_cache) / "firmware",
                  Path(installer_cache) / "installer/expanded/baseline-cache"]
    return [p for p in candidates if p.is_dir()]


def select_os_isos(requested, available, *, rehearsal, sizes=None):
    """Which OS install images the installer offers to the drive. Default: every .iso except the Proxmox installer
    (already carried); the rehearsal defaults to the smallest one so it stays quick."""
    candidates = sorted(n for n in available if n.endswith(".iso") and n != "proxmox-ve-source.iso")
    if requested:
        missing = [n for n in requested if n not in candidates]
        if missing:
            raise ValueError(f"not an OS image in {OS_ISOS}: {', '.join(missing)}")
        return list(requested)
    if rehearsal and candidates:
        return [min(candidates, key=lambda n: (sizes or {}).get(n, 0))]
    return candidates


def confirmation_ok(typed, serial):
    return isinstance(typed, str) and typed.strip() == f"WIPE {serial}"


def refuse_protected(target, protected):
    if PROTECTED is not None and target.get("serial") == PROTECTED:
        raise RuntimeError("the other SK hynix drive is protected for this run and can never be its target")
    if protected is not None and protected.get("path") == target.get("path"):
        raise RuntimeError("the target resolves to the protected drive's device; refusing")


def wipe_authorized(value):
    """The run-time authorization to erase the chosen target: its exact serial, given on the command line."""
    return SERIAL is not None and value == SERIAL


# --- shared plumbing -----------------------------------------------------------------------------

def say(*parts):
    print("[allscript]", *parts, flush=True)


def journal():
    path = WORK / "progress.json"
    data = json.loads(path.read_text()) if path.exists() else {"serial": SERIAL, "stages": {}}
    if data.get("serial") != SERIAL:
        raise RuntimeError("progress journal belongs to a different drive")
    return data


def record(stage, **facts):
    data = journal()
    data["stages"][stage] = dict(facts, finished=time.strftime("%Y-%m-%dT%H:%M:%S%z"))
    path = WORK / "progress.json"
    path.write_text(json.dumps(data, indent=2) + "\n")
    _give_to_operator(path)


def _give_to_operator(path):
    if os.geteuid() == 0:
        try:
            shutil.chown(path, OPERATOR, OPERATOR)
        except (LookupError, OSError):
            pass


def runner():
    import repair

    class RootRunner(repair.RealRunner):
        def run(self, argv, timeout=10):
            if list(argv[:2]) == ["sudo", "-n"]:
                argv = argv[2:]
            return super().run(argv, timeout=timeout)
    return RootRunner()


def identify(r):
    """The serial-validated target and the protected drive's current device, re-resolved every time."""
    import drive_recovery
    import physical_device_safety as pds
    disk = drive_recovery._offline_disk(r, SERIAL)
    target = pds.validate_target_device(disk["name"], expected_serial=SERIAL, min_size_bytes=SIZE, max_size_bytes=SIZE)
    try:
        protected = {"path": drive_recovery._offline_disk(r, PROTECTED)["name"], "serial": PROTECTED}
    except Exception:  # noqa: BLE001 - an absent protected drive cannot be confused with the target
        protected = None
    refuse_protected(target, protected)
    return target


def guarded(target):
    import physical_device_safety as pds

    def check():
        fresh = pds.validate_target_device(target["path"], expected_serial=SERIAL, min_size_bytes=SIZE,
                                           max_size_bytes=SIZE)
        if fresh != target:
            raise RuntimeError("target identity changed")
    return check


def sh(argv, *, check=True, timeout=600, env=None, input=None):
    say("running:", " ".join(shlex.quote(str(a)) for a in argv))
    return subprocess.run([str(a) for a in argv], check=check, timeout=timeout, env=env, input=input,
                          text=True, capture_output=input is not None)


def lvm_rows(r, pv):
    import single_drive_storage as storage
    report = storage._json_command(r, ["pvs", "--devices", pv, "--reportformat", "json", "-o",
                                       "pv_name,pv_uuid,vg_name,vg_uuid"])
    return report["report"][0]["pv"]


def deactivate_target_vgs(r, target):
    """Deactivate only the target's own VGs on this host, after confirming none of their LVs is mounted."""
    pv = target["path"] + "3"
    if not Path(pv).exists():
        return []
    if os.geteuid() != 0:
        active = active_lvm_volumes(json.loads(subprocess.run(
            ["lsblk", "-J", "-o", "NAME,TYPE", target["path"]], capture_output=True, text=True, check=True).stdout))
        if active:
            raise RuntimeError(
                f"this host has {TARGET_NAME}'s LVM volumes active ({len(active)}: {', '.join(active[:3])}...); deactivating them "
                "needs root. Either run once:  sudo vgchange --devices " + pv + " -an   (for each volume group on it), "
                "or stop this host activating the drive's volumes at all with an LVM filter (see DR254).")
        return []
    rows = lvm_rows(r, pv)
    for row in rows:
        mapper = "/dev/mapper/" + row["vg_name"].replace("-", "--") + "-"
        mounted = [line for line in Path("/proc/self/mountinfo").read_text().splitlines()
                   if f" {mapper}" in line]
        if mounted:
            raise RuntimeError(f"{row['vg_name']} still has mounted volumes; unmount them first")
        sh(["vgchange", "--devices", pv, "-an", row["vg_name"]], timeout=120)
    return [row["vg_name"] for row in rows]


# --- stages --------------------------------------------------------------------------------------

def stage_preflight(r):
    target = identify(r)
    say("target:", target["path"], "serial", target["serial"], f"{target['size_bytes']} bytes")
    lsblk = subprocess.run(["lsblk", "-o", "NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINTS", target["path"]],
                           capture_output=True, text=True).stdout
    print(lsblk, flush=True)
    for need in (SOURCE_ISO, ASSISTANT, PROXY):
        if not need.exists():
            raise RuntimeError(f"missing: {need}")
    free = shutil.disk_usage(BACKUP_ROOT).free
    if free < 100 * 1024**3:
        raise RuntimeError(f"less than 100 GiB free in {BACKUP_ROOT}")
    isos = select_os_isos([], [p.name for p in OS_ISOS.iterdir() if p.is_file()] if OS_ISOS.is_dir() else [], rehearsal=False)
    import drive_guard
    refresh_udev_view(target["path"])
    state = drive_guard.read_drive_state(target["path"])
    formattable = (not state.has_data) or drive_guard.is_installer_uuid(state.ptuuid)
    say("Proxmox source ISO:", SOURCE_ISO.name, "| assistant present | backup free:", f"{free // 1024**3} GiB")
    say(f"OS ISOs to offer on {TARGET_NAME}:", ", ".join(isos) or "none")
    say(f"data-protection guard would allow formatting {TARGET_NAME}:", "yes" if formattable else
        f"NO - {TARGET_NAME} holds data whose disk identifier the installer registry does not know")
    record("preflight", target=target["path"], formattable=formattable, os_isos=isos)


def stage_recovery(r):
    import drive_recovery
    identify(r)
    mounts = drive_recovery.quiesce_source(r, serial=SERIAL, allowed_serials=[SERIAL])
    say("quiesced:", mounts)
    folder = drive_recovery.create_snapshot(r, serial=SERIAL, destination=str(BACKUP_ROOT), allowed_serials=[SERIAL])
    manifest = drive_recovery.verify_snapshot(r, folder, expected_serial=SERIAL)
    say("verified recovery image:", folder)
    record("recovery", folder=str(folder), manifest=manifest)


def stage_install(r):
    import drive_recovery
    import drive_setup_acquire as dsa
    import drive_setup_answer as dsan
    import drive_setup_install as dsi
    import iso_builder as ib
    import physical_device_safety as pds
    import self_installer as si
    folder = journal()["stages"].get("recovery", {}).get("folder")
    if not folder:
        raise RuntimeError(f"run the recovery stage first; nothing is written to {TARGET_NAME} without a verified image")
    drive_recovery.verify_snapshot(r, folder, expected_serial=SERIAL)
    target = identify(r)
    refresh_udev_view(target["path"])          # the guard reads udev's cache, which an earlier install's VM leaves stale
    say("deactivated on this host:", deactivate_target_vgs(r, target))
    # The authorization is the exact `--confirm-wipe <serial>` on the command line (checked in main), after a verified
    # recovery image and under the serial lock: an interactive prompt on top of that only blocks unattended runs.
    say(f"ERASING {TARGET_NAME} ({SERIAL}, {target['path']}); verified recovery image: {folder}")
    if cache_status(CACHE_DIR) != "complete":
        raise RuntimeError("run the cache stage first; the installer must carry its own packages and applications")
    target = identify(r)
    workspace = WORK / "installer"
    result = si.build_and_write_self_installer(
        device_path=target["path"], device_min_size_bytes=SIZE, expected_serial=SERIAL,
        pds_runner=pds.Runner(), acquire_runner=dsa.RealAcquireRunner(), answer_runner=dsan.RealAnswerRunner(),
        iso_builder_runner=ib.RealIsoBuilderRunner(), install_runner=dsi.RealInstallRunner(),
        workspace=workspace, repo_root=REPO, assistant_binary=ASSISTANT, proxmox_source_iso=SOURCE_ISO,
        fqdn=fqdn_for(TARGET_NAME), memory_mb=8192, on_progress=lambda line: say(line),
        offline_cache=CACHE_DIR, os_share=OS_OFFER, **si.LVM_SIZE_PRESETS["single-drive"])
    say(result.outcome + ":", result.detail)
    if result.outcome != "applied" or result.qemu_process is None:
        raise RuntimeError(f"the installer refused or did not launch; {TARGET_NAME} was not written by this stage")
    global INSTALL_VM
    INSTALL_VM = result.qemu_process
    # Same KVM session, ISO still attached: Proxmox installs, reboots, its first boot runs the carried hook
    # (storage, installer carried onto INSTALLER_CACHE, offline provision), then reboots into first-boot
    # authorization. Nothing here reads console text (no OCR, by design): a person or vision-capable agent watches
    # the screendump and records each checkpoint.
    watch("firstboot-screen", "the Baseline first-boot authorization screen (asking for CONFIRM)")
    record("install", workspace=str(workspace))


def clear_stale_checkpoint(path):
    """A checkpoint left by an earlier run says nothing about this one; only a touch after the wait begins counts."""
    Path(path).unlink(missing_ok=True)


def watch(checkpoint, description):
    """Refresh the session screendump until the named checkpoint file is created by whoever is watching it."""
    done = WORK / f"seen-{checkpoint}"
    clear_stale_checkpoint(done)
    shot = WORK / "session-latest.ppm"
    say(f"waiting for {description}; screendump: {shot} - when it shows, run:  touch {done}")
    while not done.exists():
        if INSTALL_VM.poll() is not None:
            raise RuntimeError(f"the installation VM exited ({INSTALL_VM.poll()}) before: {description}")
        try:
            INSTALL_VM.send_monitor_command(f"screendump {shot}")
            _give_to_operator(shot)
        except (OSError, RuntimeError):
            pass
        time.sleep(10)


def send_keys(text):
    names = {"\n": "ret", " ": "spc", "-": "minus", ".": "dot", "/": "slash"}
    for char in text:
        key = names.get(char) or (f"shift-{char.lower()}" if char.isupper() else char)
        INSTALL_VM.send_monitor_command(f"sendkey {key}")
        time.sleep(0.05)


def stage_cache(r):
    status = cache_status(CACHE_DIR)
    if status == "without_apps":
        kept = CACHE_DIR.with_name(CACHE_DIR.name + "-before-apps")
        if kept.exists():
            raise RuntimeError(f"{kept} already exists; move it away so the older cache is never overwritten")
        say("the existing cache carries no applications; keeping it as", kept, "and building a complete one")
        CACHE_DIR.rename(kept)
        status = "missing"
    if status == "complete":
        say("offline package cache already built:", CACHE_DIR)
    else:
        earlier = sorted(BUILD.glob(CACHE_DIR.name + "-before-*"))
        seeds = cache_seeds(OS_ISOS.parent, earlier)
        say("seeding the build from:", ", ".join(map(str, seeds)) or "nothing yet; everything is downloaded")
        sh([REPO / "baseline/bin/baseline-build-offline-cache", "--source-iso", SOURCE_ISO, "--assistant", ASSISTANT,
            "--workspace", BUILD / "cache-vm", "--output", CACHE_DIR, "--apps", APPS_DIR,
            *[arg for seed in seeds for arg in ("--seed", seed)]], timeout=14400)
    import offline_cache
    import application_bundle
    count = offline_cache.verify_manifest(CACHE_DIR, json.loads((CACHE_DIR / "MANIFEST.json").read_text()))
    apps = offline_cache.verify_app_bundle(CACHE_DIR, application_bundle.APPS)
    record("cache", path=str(CACHE_DIR), files=count, apps={a["app"]: a["version"] for a in apps})


def offer_os_isos(names):
    """Hard-link the chosen images (plus sums) next to INSTALLER_CACHE/isos; the installer VM shares that folder."""
    import os_isos
    global OS_OFFER
    OS_OFFER = os_isos.build_offer(OS_ISOS, names, OS_ISOS.parent / ".baseline-offer")
    say("offering OS images to the installed system:", ", ".join(names))


def withdraw_os_offer():
    if OS_OFFER is not None:
        shutil.rmtree(OS_OFFER, ignore_errors=True)


def stage_rehearse(r):
    """The same self-contained installer, run against a blank sparse disk the size of the SK hynix targets with NO network.

    Built by the same functions as the real install (render_answer, first_boot_hook, prepare_iso_defensively,
    iso_builder with the offline cache). Only the answer delivery differs: embedded in the ISO, which docs/INSTALL.md
    accepts for disposable VMs only; the real install keeps the HTTP answer server. No root, no physical drive.
    """
    import drive_setup_answer as dsan
    import drive_setup_install as dsi
    import first_boot_hook as fbh
    import iso_builder as ib
    import self_installer as si
    if cache_status(CACHE_DIR) != "complete":
        raise RuntimeError("run the cache stage first (the cache must carry the applications)")
    work = BUILD / "rehearsal"
    if work.exists():
        shutil.rmtree(work)
    work.mkdir(parents=True)
    password = dsan.generate_one_time_password()
    secret = work / "root-password"; secret.write_bytes(password + b"\n"); secret.chmod(0o600)
    answer = work / "answer.toml"
    answer.write_text(si.render_answer(fqdn="baseline-rehearsal.local",
                                       password_hash=dsan.hash_password_sha512crypt(password, secrets.token_hex(8)),
                                       disk_serial="BLREHEARSAL01", first_boot=True,
                                       **si.LVM_SIZE_PRESETS["single-drive"]))
    answer.chmod(0o600)                                    # holds the password hash; the build drive's ACLs widen it
    hook = fbh.build_hook(REPO, work / "baseline-first-boot")
    prepared = dsan.prepare_iso_defensively(
        dsan.RealAnswerRunner(), binary=ASSISTANT, source_iso=SOURCE_ISO, answer_file=answer, fetch_from="iso",
        output_path=work / "answer.iso", tmp_dir=work / "prep-tmp", workspace_root=work, expected_fetch_mode="iso",
        min_size=1_000_000_000, max_size=3_000_000_000, forbidden_iso_strings=[],
        extra_args=["--on-first-boot", str(hook)])
    if not prepared.ok:
        raise RuntimeError(f"prepare-iso failed: {[c for c in prepared.postconditions if not c.ok]}")
    built = ib.build_current_iso(ib.RealIsoBuilderRunner(), source_iso=work / "answer.iso", repo_root=REPO,
                                 output_iso=work / "installer.iso", workspace=work / "iso-build",
                                 offline_cache=CACHE_DIR)
    if not built.ok:
        raise RuntimeError(f"ISO build failed: {[c for c in built.postconditions if not c.ok]}")
    disk = work / "disk.raw"
    with open(disk, "wb") as stream:
        stream.truncate(SIZE)                                  # sparse, same size as either SK hynix target
    invocation = dsi.build_sparse_install_invocation(
        target_image=disk, prepared_iso=work / "installer.iso", mac="52:54:00:ba:5e:7e",
        smbios_product="baseline-rehearsal", serial_log=work / "serial.log", memory_mb=8192, smp=4,
        restrict_network=True, monitor_socket=work / "monitor.sock", target_serial="BLREHEARSAL01",
        share_dir=OS_OFFER)
    argv = invocation.argv + ["-display", "none"]
    global INSTALL_VM
    INSTALL_VM = dsi.RealInstallRunner().popen(argv, monitor_socket=work / "monitor.sock")
    say("rehearsal installing with no network; root password for this disposable VM:", secret)
    watch("firstboot-screen", "the Baseline first-boot authorization screen (asking for CONFIRM)")
    record("rehearse", workspace=str(work))


def stage_session_firstboot(r):
    if INSTALL_VM is None:
        raise RuntimeError("firstboot continues the install stage's session; run them in one invocation")
    send_keys("CONFIRM\n")
    say("CONFIRM typed on the first-boot screen")
    watch("kiosk", "the kiosk browser showing the Proxmox login")
    record("firstboot")


def stage_session_kiosk(r):
    if INSTALL_VM is None:
        raise RuntimeError("kiosk continues the install stage's session; run them in one invocation")
    shot = WORK / "kiosk.ppm"
    INSTALL_VM.send_monitor_command(f"screendump {shot}")
    time.sleep(1)
    from drive_setup_install import ppm_to_png
    (WORK / "kiosk.png").write_bytes(ppm_to_png(shot.read_bytes()))
    _give_to_operator(WORK / "kiosk.png")
    INSTALL_VM.send_monitor_command("system_powerdown")
    code = INSTALL_VM.wait(timeout=600)
    say(f"{TARGET_NAME or 'the rehearsal VM'} shut down cleanly after the kiosk was shown; QEMU exit", code)
    withdraw_os_offer()
    record("kiosk", screenshot=str(WORK / "kiosk.png"), qemu_exit=code)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--stage", help="run only this stage")
    parser.add_argument("--from", dest="start", help="run this stage and every later one")
    parser.add_argument("--target", choices=sorted(DRIVES),
                        help="the drive this run may touch; the other is protected. No default.")
    parser.add_argument("--os-iso", action="append", default=[], metavar="NAME",
                        help="an image in /mnt/INSTALLER_CACHE/isos to carry onto the drive (repeatable); "
                             "default: every .iso (the rehearsal: the smallest)")
    parser.add_argument("--confirm-wipe", default="", metavar="SERIAL",
                        help="authorize erasing the target (after its verified recovery image); its exact serial")
    args = parser.parse_args()
    global CONFIRMED_WIPE, WORK
    CONFIRMED_WIPE = args.confirm_wipe
    stages = select_stages(args.stage, args.start)
    select_target(*target_for(args.target, CONFIRMED_WIPE, stages))
    WORK = work_dir(TARGET_NAME, stages)
    if TARGET_NAME:
        say(f"target {TARGET_NAME} ({SERIAL}); protected for this run: {PROTECTED}; work folder {WORK}")
    if "install" in stages and not wipe_authorized(CONFIRMED_WIPE):
        raise RuntimeError(f"the install stage erases {TARGET_NAME}: add  --confirm-wipe {SERIAL}")
    needs_root = root_required(stages)
    if needs_root and os.geteuid() != 0:
        raise RuntimeError(f"stages {', '.join(needs_root)} need root: run with sudo")
    WORK.mkdir(mode=0o750, parents=True, exist_ok=True)
    _give_to_operator(WORK)
    if {"install", "rehearse"} & set(stages):
        available = [p.name for p in OS_ISOS.iterdir() if p.is_file()] if OS_ISOS.is_dir() else []
        sizes = {n: (OS_ISOS / n).stat().st_size for n in available}
        names = select_os_isos(args.os_iso, available, rehearsal="rehearse" in stages, sizes=sizes)
        if names:
            offer_os_isos(names)
        else:
            say("no OS images in", OS_ISOS, "- the drive will carry none")
    r = runner()
    functions = {"preflight": stage_preflight, "recovery": stage_recovery, "cache": stage_cache,
                 "rehearse": stage_rehearse, "install": stage_install, "firstboot": stage_session_firstboot,
                 "kiosk": stage_session_kiosk, "identity": lambda r: finalize_target_identity()}
    try:
        for stage in stages:
            say(f"=== {stage} ===")
            functions[stage](r)
    finally:
        if "install" in stages and TARGET_NAME:
            try:
                finalize_target_identity()
            except (RuntimeError, OSError, subprocess.SubprocessError) as exc:
                say("the drive's identity was not stamped:", exc)
    say("done:", ", ".join(stages))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
        print(f"[allscript] STOPPED, nothing claimed complete: {exc}", file=sys.stderr)
        sys.exit(1)
