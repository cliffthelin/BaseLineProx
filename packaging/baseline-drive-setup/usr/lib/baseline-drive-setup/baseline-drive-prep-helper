#!/bin/bash
# Root-owned, root-only-writable helper invoked via pkexec from
# baseline-drive-setup-gui. PolicyKit (the OS's own authentication
# mechanism) is what actually gates root access here - this script does
# not grant itself any privilege, it only runs with whatever privilege
# pkexec already authenticated for that invocation.
#
# Generic by design - no hardcoded username, mount path, or fixed drive
# label. Every destructive subcommand re-validates its target device's
# CURRENT filesystem label against the label the caller says it saw
# when the device was selected (passed as an explicit argument), and
# looks up the device's CURRENT mountpoint from the kernel rather than
# assuming one - so this works the same for any user, on any desktop,
# with any drive label, not just one specific setup.
set -euo pipefail

usage() {
    echo "usage: $0 {status|unmount <device>|qemu-install <device> <expected-label> <iso-path>}" >&2
    exit 2
}

require_confirmed_device() {
    local dev="$1" expected_label="$2"
    if [ ! -b "$dev" ]; then
        echo "REFUSING: $dev is not a block device." >&2
        exit 1
    fi
    local label
    label="$(lsblk -no LABEL "$dev" 2>/dev/null | head -1)"
    if [ "$label" != "$expected_label" ]; then
        echo "REFUSING: $dev now has filesystem label '$label', but '$expected_label' was expected (the label seen when it was selected) - not touching it." >&2
        exit 1
    fi
}

current_mountpoint() {
    findmnt -no TARGET "$1" 2>/dev/null || true
}

case "${1:-}" in
    status)
        lsblk -o NAME,LABEL,SIZE,TYPE,MOUNTPOINT
        ;;
    unmount)
        dev="${2:?device required, e.g. /dev/sdc1}"
        mp="$(current_mountpoint "$dev")"
        if [ -n "$mp" ]; then
            umount "$mp"
            echo "unmounted $dev from $mp"
        else
            echo "$dev was not mounted"
        fi
        ;;
    qemu-install)
        dev="${2:?device required, e.g. /dev/sdc}"
        expected_label="${3:?expected filesystem label required (the label seen when the device was selected)}"
        iso="${4:?path to the prepared install ISO required}"
        require_confirmed_device "$dev" "$expected_label"
        if [ ! -f "$iso" ]; then
            echo "REFUSING: $iso does not exist." >&2
            exit 1
        fi
        mp="$(current_mountpoint "$dev")"
        if [ -n "$mp" ]; then
            umount "$mp"
        fi
        exec qemu-system-x86_64 \
            -enable-kvm -m 4096 -smp 2 \
            -drive "file=${dev},format=raw,if=virtio,cache=none" \
            -cdrom "$iso" \
            -boot d \
            -nographic -serial mon:stdio \
            -no-reboot
        ;;
    *)
        usage
        ;;
esac
