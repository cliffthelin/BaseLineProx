[Unit]
Description=Baseline scripts inbox - CRUD server for pushing scripts to run later (login-gated)
After=network-online.target baseline-persist-bind-mounts.service
Wants=network-online.target
Requires=baseline-persist-bind-mounts.service

[Service]
Type=simple
ExecStartPre=/opt/baseline/bin/baseline-scripts-inbox-gate
ExecStart=/opt/baseline/bin/baseline-scripts-inbox 8200
# The installed code is mounted read-only for the service, so nothing it runs can rewrite
# the code that decides who gets privileges. (No NoNewPrivileges: Drive Administration needs pkexec.)
ReadOnlyPaths=/opt/baseline
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=5
Environment=BASELINE_SCRIPTS_INBOX_DATA=/mnt/USER/scripts-inbox-auth/store.json
Environment=BASELINE_SCRIPTS_INBOX_DIR=/mnt/USER/scripts_inbox
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
