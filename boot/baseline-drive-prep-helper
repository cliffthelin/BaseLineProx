#!/bin/bash
# Root-owned, root-only-writable helper invoked via pkexec from
# baseline-drive-setup-gui. PolicyKit (the OS's own authentication
# mechanism) is what actually gates root access here - this script does
# not grant itself any privilege, it only runs with whatever privilege
# pkexec already authenticated for that invocation.
#
# Every destructive subcommand re-validates its target device against
# an explicit expected filesystem label before touching anything, so a
# bug, a bad argument, or a device that ended up at a different /dev/sdX
# letter this boot can't silently get targeted instead.
set -euo pipefail

EXPECTED_LABEL="BaseLine"
EXPECTED_MOUNTPOINT="/run/media/cane/BaseLine"

usage() {
    echo "usage: $0 {status|unmount-target|qemu-install <device> <iso-path>}" >&2
    exit 2
}

require_confirmed_device() {
    local dev="$1"
    if [ ! -b "$dev" ]; then
        echo "REFUSING: $dev is not a block device." >&2
        exit 1
    fi
    local label
    label="$(lsblk -no LABEL "$dev" 2>/dev/null | head -1)"
    if [ "$label" != "$EXPECTED_LABEL" ]; then
        echo "REFUSING: $dev has filesystem label '$label', expected '$EXPECTED_LABEL' - not touching it." >&2
        exit 1
    fi
}

case "${1:-}" in
    status)
        lsblk -o NAME,LABEL,SIZE,TYPE,MOUNTPOINT
        ;;
    unmount-target)
        if mountpoint -q "$EXPECTED_MOUNTPOINT"; then
            umount "$EXPECTED_MOUNTPOINT"
            echo "unmounted $EXPECTED_MOUNTPOINT"
        else
            echo "$EXPECTED_MOUNTPOINT was not mounted"
        fi
        ;;
    qemu-install)
        dev="${2:?device required, e.g. /dev/sdc}"
        iso="${3:?path to the prepared install ISO required}"
        require_confirmed_device "$dev"
        if [ ! -f "$iso" ]; then
            echo "REFUSING: $iso does not exist." >&2
            exit 1
        fi
        if mountpoint -q "$EXPECTED_MOUNTPOINT"; then
            umount "$EXPECTED_MOUNTPOINT"
        fi
        exec qemu-system-x86_64 \
            -enable-kvm -m 4096 -smp 2 \
            -drive "file=${dev},format=raw,if=virtio,cache=none" \
            -cdrom "$iso" \
            -boot d \
            -nographic -serial mon:stdio \
            -no-reboot
        ;;
    *)
        usage
        ;;
esac
