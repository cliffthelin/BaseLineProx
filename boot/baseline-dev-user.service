[Unit]
Description=Baseline development login (Linux user and Proxmox Administrator)
ConditionPathExists=/etc/baseline/dev-user.hash
After=pve-cluster.service pvedaemon.service pveproxy.service network-online.target
Wants=pve-cluster.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/baseline-dev-user

[Install]
WantedBy=multi-user.target
