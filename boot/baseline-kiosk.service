[Unit]
Description=Baseline kiosk GUI (Track A3) - Chromium onto Proxmox's own web UI
Conflicts=getty@tty3.service
After=getty@tty3.service network-online.target baseline-firstboot.service pveproxy.service baseline-storage-verify.service baseline-persist-bind-mounts.service
Wants=network-online.target
RequiresMountsFor=/mnt/USER_ADMIN
Requires=pveproxy.service
# Never give up (systemd reads this key in [Unit]; in [Service] it was ignored with a warning at every boot).
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/opt/baseline/bin/baseline-kiosk-gate
ExecStartPre=/usr/bin/chvt 3
# Cage takes the foreground only once it runs; the console on tty1 must not be what stays on screen.
ExecStartPost=/usr/bin/chvt 3
RuntimeDirectory=cage-kiosk
RuntimeDirectoryMode=0700
# A real browser window (tabs, address bar, bookmarks bar), not a locked kiosk page: Proxmox's web GUI and Baseline open as two tabs, and the
# machine's own screen can reach any other page. Cage gives the one window the whole screen. The profile is on USER_ADMIN, so the
# browser's own settings (and Proxmox's colour theme, which it keeps in the browser) are kept between boots.
ExecStart=/usr/bin/cage -s -- /usr/bin/chromium --user-data-dir=/mnt/USER_ADMIN/chromium/kiosk --no-sandbox --disable-gpu --ozone-platform=wayland --ignore-certificate-errors --test-type --no-first-run --disable-session-crashed-bubble https://localhost:8006 http://localhost:8100
# A kiosk is always up: restart it whenever it stops, for any reason (cage exits cleanly when its browser exits, and the gate may refuse
# once at boot while storage verification is still running), and never give up. Found on PC601, 2026-10-12: one start at boot, then nothing.
Restart=always
RestartSec=5
Environment=XDG_RUNTIME_DIR=/run/cage-kiosk
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
Environment=LIBSEAT_BACKEND=builtin
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty3
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
