[Unit]
Description=Baseline kiosk GUI (Track A3) - Chromium onto Proxmox's own web UI
Conflicts=getty@tty3.service
After=getty@tty3.service network-online.target baseline-firstboot.service pveproxy.service
Wants=network-online.target
RequiresMountsFor=/mnt/APPDATA_ADMIN
Requires=pveproxy.service

[Service]
Type=simple
ExecStartPre=/opt/baseline/bin/baseline-kiosk-gate
ExecStartPre=/usr/bin/chvt 3
RuntimeDirectory=cage-kiosk
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/cage -s -- /usr/bin/chromium --kiosk --user-data-dir=/mnt/APPDATA_ADMIN/chromium/kiosk --no-sandbox --disable-gpu --ozone-platform=wayland --ignore-certificate-errors https://localhost:8006
Restart=on-failure
RestartSec=5
Environment=XDG_RUNTIME_DIR=/run/cage-kiosk
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
Environment=LIBSEAT_BACKEND=builtin
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty3
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
