[Unit]
Description=Baseline kiosk GUI (Track A3) - Chromium onto Proxmox's own web UI
Conflicts=getty@tty3.service
After=getty@tty3.service network-online.target baseline-firstboot.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/opt/baseline/bin/baseline-kiosk-gate
ExecStartPre=/usr/bin/mkdir -p /run/cage-kiosk
ExecStart=/usr/bin/cage -s -- /usr/bin/chromium --kiosk --no-sandbox --disable-gpu --ozone-platform=wayland --ignore-certificate-errors https://localhost:8006
Restart=on-failure
RestartSec=5
Environment=XDG_RUNTIME_DIR=/run/cage-kiosk
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty3
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
