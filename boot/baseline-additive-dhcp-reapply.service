[Unit]
Description=Baseline additive-repair DHCP reapply (decision record 17)
After=networking.service
Wants=networking.service

[Service]
Type=oneshot
ExecStart=/opt/baseline/bin/baseline-additive-dhcp-reapply
# The installed code is mounted read-only for the service, so nothing it runs can rewrite
# the code that decides who gets privileges. (No NoNewPrivileges: Drive Administration needs pkexec.)
ReadOnlyPaths=/opt/baseline
Environment=PYTHONDONTWRITEBYTECODE=1
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
