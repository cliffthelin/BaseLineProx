[Unit]
Description=Baseline first-boot network-repair authorization (Gate E)
Conflicts=getty@tty1.service
After=getty@tty1.service network-online.target baseline-persist-bind-mounts.service
Before=baseline.service
Wants=network-online.target
Requires=baseline-persist-bind-mounts.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/baseline/bin/baseline-firstboot
# The installed code is mounted read-only for the service, so nothing it runs can rewrite
# the code that decides who gets privileges. (No NoNewPrivileges: Drive Administration needs pkexec.)
ReadOnlyPaths=/opt/baseline
Environment=PYTHONDONTWRITEBYTECODE=1
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
