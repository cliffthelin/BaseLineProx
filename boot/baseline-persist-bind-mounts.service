[Unit]
Description=Baseline persistence redirects (credentials/state/logs onto USER)
After=local-fs.target
Before=baseline-firstboot.service baseline.service
Requires=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/baseline/bin/baseline-persist-bind-mounts
# Bind mounts must be visible in the host namespace. ReadOnlyPaths creates
# a private namespace and hides these mounts from dependent services.
# Provisioning still enforces root-owned code without group/world write access.
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
