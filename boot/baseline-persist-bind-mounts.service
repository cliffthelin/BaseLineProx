[Unit]
Description=Baseline persistence redirects (credentials/state/logs onto USER)
After=local-fs.target
Before=baseline-firstboot.service baseline.service
Requires=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/baseline/bin/baseline-persist-bind-mounts
# The installed code is mounted read-only for the service, so nothing it runs can rewrite
# the code that decides who gets privileges. (No NoNewPrivileges: Drive Administration needs pkexec.)
ReadOnlyPaths=/opt/baseline
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
